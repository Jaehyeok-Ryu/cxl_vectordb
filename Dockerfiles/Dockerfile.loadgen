# ============================================================
# Dockerfile.loadgen  (GPU Full-Pipeline Image)
# ============================================================
# GPU 서버에서 사용:
#   - Mode B: embed_documents.py  (raw text → embedding)
#   - Mode B: build_vectorDB.py --inline-embed (embed + insert)
# CPU 전용 삽입은 Dockerfile.vectordb_insert 사용
# ============================================================

FROM pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime

# 시스템 의존성
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python 패키지 설치
RUN pip install --no-cache-dir \
    qdrant-client==1.9.1 \
    transformers==4.40.2 \
    sentence-transformers==3.0.1 \
    datasets==2.19.2 \
    pyarrow \
    accelerate \
    flask

WORKDIR /app

# 스크립트 복사
COPY build_vectorDB.py   /app/build_vectorDB.py
COPY embed_documents.py  /app/embed_documents.py

CMD ["python3", "/app/build_vectorDB.py"]